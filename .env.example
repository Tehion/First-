# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Database (SQLite by default; swap to postgresql+asyncpg://... for production)
DATABASE_URL=sqlite+aiosqlite:///./competitor_monitor.db

# Email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your@email.com
EMAIL_TO=lukas.zimmermann@example.com

# Scraping
# Comma-separated list of proxy URLs (optional, for Cloudflare bypass)
PROXY_URLS=

# Schedule (cron expression, default: daily at 07:00)
SCHEDULE_CRON=0 7 * * *

# Logging
LOG_LEVEL=INFO
